{
  "schemaVersion": 1,
  "id": "cve",
  "name": "CVE ID",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_-])(?P<value>(?i:CVE)-[0-9]{4}-[0-9]{4,})(?:\\z|[^\\p{L}\\p{N}_-])",
  "valueGroup": "value",
  "validation": "cve",
  "examples": [
    {
      "text": "CVE-2024-1234,cve-2025-1234567",
      "values": [
        "CVE-2024-1234",
        "cve-2025-1234567"
      ]
    },
    {
      "text": "CVE-1999-0001",
      "values": [
        "CVE-1999-0001"
      ]
    },
    {
      "text": "CVE-2025-12 XCVE-2025-1234 CVE-2025-1234suffix",
      "values": []
    }
  ]
}
