{
  "name": "trivium-desktop",
  "version": "0.3.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "lint:test": "tsc -p tsconfig.test.json",
    "contracts:check": "cargo run --locked -p trivium-engine --bin export_contracts -- --check",
    "contracts:generate": "cargo run --locked -p trivium-engine --bin export_contracts",
    "test:ui": "node --test --experimental-strip-types src/lib/*.test.ts scripts/generate-themes.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "prelint": "node scripts/generate-themes.mjs",
    "prelint:test": "node scripts/generate-themes.mjs",
    "pretest:ui": "node scripts/generate-themes.mjs",
    "definitions:check": "node scripts/generate-themes.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "dayjs": "^1.11.13",
    "svelte": "^5.59.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "postcss-load-config": "^5.1.0",
    "svelte-check": "^4.7.8",
    "svelte-preprocess": "^6.0.5",
    "tailwindcss": "^3.4.13",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.4.0"
  }
}
