{
  "schemaVersion": 1,
  "id": "email",
  "name": "Email address",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_.@+\\-])(?P<value>[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_`{|}~-]+)*@(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:[A-Za-z]{2,63}|[Xx][Nn]--[A-Za-z0-9-]{2,59}))(?:\\z|[^\\p{L}\\p{N}_.@+\\-])",
  "valueGroup": "value",
  "validation": "email",
  "examples": [
    {
      "text": "Sender: <alice+review@example.technology>",
      "values": [
        "alice+review@example.technology"
      ]
    },
    {
      "text": "one@example.org,two.test@sub.example.net",
      "values": [
        "one@example.org",
        "two.test@sub.example.net"
      ]
    },
    {
      "text": "o'connor@example.org",
      "values": [
        "o'connor@example.org"
      ]
    },
    {
      "text": "alice..bob@example.org test@example.1 missing@host",
      "values": []
    }
  ]
}
