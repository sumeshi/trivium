{
  "name": "trivium-desktop",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "svelte-check --tsconfig ./tsconfig.json",
    "lint:test": "tsc -p tsconfig.test.json",
    "contracts:check": "cargo run --locked -p trivium-engine --bin export_contracts -- --check",
    "contracts:generate": "cargo run --locked -p trivium-engine --bin export_contracts",
    "test:ui": "node --test --experimental-strip-types src/lib/*.test.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "dayjs": "^1.11.13",
    "svelte": "^4.2.18"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^20.14.12",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "postcss-load-config": "^5.1.0",
    "svelte-check": "^3.7.1",
    "svelte-preprocess": "^5.1.4",
    "tailwindcss": "^3.4.13",
    "tslib": "^2.6.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
