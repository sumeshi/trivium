{
  "schemaVersion": 1,
  "id": "ipv6",
  "name": "IPv6",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_:.%])(?P<value>[0-9A-Fa-f]{0,4}:[0-9A-Fa-f:.]+(?:%[A-Za-z0-9_.-]{1,64})?)(?:\\z|[^\\p{L}\\p{N}_:.%])",
  "valueGroup": "value",
  "validation": "ipv6",
  "examples": [
    {
      "text": "src=[2001:db8::1] loopback=::1",
      "values": [
        "2001:db8::1",
        "::1"
      ]
    },
    {
      "text": "::1,2001:db8::2,::ffff:192.0.2.1",
      "values": [
        "::1",
        "2001:db8::2",
        "::ffff:192.0.2.1"
      ]
    },
    {
      "text": "bad=2001:db8:::1 12345::1 ::ffff:999.1.2.3",
      "values": []
    }
  ]
}
