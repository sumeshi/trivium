{
  "version": 1,
  "id": "light",
  "name": "Light",
  "order": 1,
  "mode": "light",
  "pastel": false,
  "tokens": {
    "bg": "#ffffff",
    "fg": "#20252d",
    "muted": "#56616f",
    "surface": "#ffffff",
    "surface-weak": "#f0f3f6",
    "surface-soft": "#fcfcfd",
    "surface-strong": "#e7edf3",
    "overlay": "rgba(238, 240, 245, 0.9)",
    "border": "#c7ced7",
    "border-strong": "#828e9c",
    "hover": "color-mix(in srgb, var(--fg) 5%, var(--surface))",
    "heading": "var(--fg)",
    "accent": "#526b82",
    "accent-contrast": "#ffffff",
    "accent-soft": "color-mix(in srgb, var(--accent) 12%, var(--surface))",
    "accent-border": "var(--accent)",
    "positive": "#176345",
    "positive-soft": "color-mix(in srgb, var(--positive) 12%, var(--surface))",
    "warning": "#80520b",
    "warning-soft": "color-mix(in srgb, var(--warning) 12%, var(--surface))",
    "danger": "#a72840",
    "danger-soft": "color-mix(in srgb, var(--danger) 12%, var(--surface))",
    "flag-selected-text": "#ffffff",
    "flag-safe-text": "var(--positive)",
    "flag-suspicious-text": "var(--warning)",
    "flag-critical-text": "var(--danger)",
    "flag-safe-selected-bg": "color-mix(in srgb, var(--positive) 24%, var(--surface))",
    "flag-safe-selected-fg": "var(--positive)",
    "flag-suspicious-selected-bg": "color-mix(in srgb, var(--warning) 24%, var(--surface))",
    "flag-suspicious-selected-fg": "var(--warning)",
    "flag-critical-selected-bg": "color-mix(in srgb, var(--danger) 24%, var(--surface))",
    "flag-critical-selected-fg": "var(--danger)",
    "bookmark-row-strength": "10%",
    "bookmark": "#8a6515",
    "bookmark-soft": "color-mix(in srgb, var(--bookmark) 10%, var(--surface))",
    "shadow-soft": "0 8px 24px rgba(31, 41, 55, 0.09)",
    "shadow-strong": "0 18px 48px rgba(31, 41, 55, 0.17)",
    "rule-red": "#fbe4e4",
    "rule-orange": "#fbe9db",
    "rule-amber": "#faf1d5",
    "rule-green": "#e2f3e8",
    "rule-teal": "#dcf2f0",
    "rule-blue": "#e3ecfb",
    "rule-purple": "#ece6fb",
    "rule-pink": "#fbe4ef",
    "flag-safe-selected-border": "color-mix(in srgb, var(--positive) 40%, var(--surface))",
    "flag-suspicious-selected-border": "color-mix(in srgb, var(--warning) 40%, var(--surface))",
    "flag-critical-selected-border": "color-mix(in srgb, var(--danger) 40%, var(--surface))"
  }
}
