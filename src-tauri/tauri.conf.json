{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trivium",
  "version": "0.2.0",
  "identifier": "com.trivium.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trivium",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "dragDropEnabled": false,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "targets": ["deb"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
