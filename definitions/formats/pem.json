{
  "schemaVersion": 1,
  "id": "pem",
  "name": "PEM block candidate",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_-])(?P<value>-----BEGIN [A-Z0-9 ]{1,64}-----[ \\t]*\\r?\\n[A-Za-z0-9+/=\\r\\n \\t]+-----END [A-Z0-9 ]{1,64}-----)(?:\\z|[^\\p{L}\\p{N}_-])",
  "valueGroup": "value",
  "validation": "pem",
  "examples": [
    {
      "text": "-----BEGIN CERTIFICATE-----\nMAMCAQA=\n-----END CERTIFICATE-----",
      "values": [
        "-----BEGIN CERTIFICATE-----\nMAMCAQA=\n-----END CERTIFICATE-----"
      ]
    },
    {
      "text": "-----BEGIN CERTIFICATE-----\nMAMCAQA=\n-----END CERTIFICATE-----\n-----BEGIN PRIVATE KEY-----\r\nMAMCAQA=\r\n-----END PRIVATE KEY-----",
      "values": [
        "-----BEGIN CERTIFICATE-----\nMAMCAQA=\n-----END CERTIFICATE-----",
        "-----BEGIN PRIVATE KEY-----\r\nMAMCAQA=\r\n-----END PRIVATE KEY-----"
      ]
    },
    {
      "text": "-----BEGIN CERTIFICATE-----\nMAMCAQA=\n-----END PRIVATE KEY-----",
      "values": []
    }
  ]
}
