  "pattern": "(?:\\A|[^\\p{L}\\p{N}_@.\\]\\)}-])(?P<value>[0-9]{1,3}(?:(?:\\.|\\[\\.\\]|\\(\\.\\)|\\{\\.\\})[0-9]{1,3}){3}(?::[0-9]{1,5}|/[0-9]{1,3})?)(?:\\z|[^\\p{L}\\p{N}_@.\\[\\(\\{:/-])",
  "valueGroup": "value",
  "validation": "ipv4-like",
