{
  "schemaVersion": 1,
  "id": "hex",
  "name": "Hex data candidate (64+ characters)",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_])(?:0[xX])?(?P<value>[0-9A-Fa-f]{64,})(?:\\z|[^\\p{L}\\p{N}_])",
  "valueGroup": "value",
  "validation": "hex",
  "examples": [
    {
      "text": "0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "values": [
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
      ]
    },
    {
      "text": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef,0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF",
      "values": [
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF"
      ]
    },
    {
      "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa gggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggggg x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
      "values": []
    }
  ]
}
