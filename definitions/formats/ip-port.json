{
  "schemaVersion": 1,
  "id": "ip-port",
  "name": "IP endpoint",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_:.%\\[\\]])(?P<value>(?:(?:[0-9]{1,3}\\.){3}[0-9]{1,3}|\\[[0-9A-Fa-f]{0,4}:[0-9A-Fa-f:.]+(?:%[A-Za-z0-9_.-]{1,64})?\\]):[0-9]{1,5})(?:\\z|[^\\p{L}\\p{N}_:.%\\[\\]])",
  "valueGroup": "value",
  "validation": "ip-port",
  "examples": [
    {
      "text": "remote=192.0.2.1:443,[2001:db8::1]:8443",
      "values": [
        "192.0.2.1:443",
        "[2001:db8::1]:8443"
      ]
    },
    {
      "text": "[::1]:80 127.0.0.1:0",
      "values": [
        "[::1]:80",
        "127.0.0.1:0"
      ]
    },
    {
      "text": "999.1.2.3:443 192.0.2.1:65536 [2001:db8:::1]:80",
      "values": []
    }
  ]
}
