{
  "schemaVersion": 1,
  "id": "domain",
  "name": "Domain / FQDN candidate",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_@.\\]\\)}-])(?P<value>(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.|\\[\\.\\]|\\(\\.\\)|\\{\\.\\}))+(?:[A-Za-z]{2,63}|[Xx][Nn]--[A-Za-z0-9-]{2,59})(?:\\.|\\[\\.\\]|\\(\\.\\)|\\{\\.\\})?)(?:\\z|[^\\p{L}\\p{N}_@.\\[\\(\\{-])",
  "valueGroup": "value",
  "validation": "domain-like",
  "examples": [
    {
      "text": "hosts=one.example,other.technology",
      "values": [
        "one.example",
        "other.technology"
      ]
    },
    {
      "text": "xn--bcher-kva.example sub.EXAMPLE.ORG",
      "values": [
        "xn--bcher-kva.example",
        "sub.EXAMPLE.ORG"
      ]
    },
    {
      "text": "one[.]example,bad.example[.]technology,two(.)example,three{.}example",
      "values": [
        "one[.]example",
        "bad.example[.]technology",
        "two(.)example",
        "three{.}example"
      ]
    },
    {
      "text": "example.com.,other.example.,sub[.]example[.]",
      "values": [
        "example.com.",
        "other.example.",
        "sub[.]example[.]"
      ]
    },
    {
      "text": "(example.com.) [sub.example.]",
      "values": [
        "example.com.",
        "sub.example."
      ]
    },
    {
      "text": "alice@example.org alice@sub[.]example.com a@one(.)example b@two{.}example",
      "values": []
    },
    {
      "text": "example.1 -bad.example bad_.example invalid..example bad_[.]example.org invalid[.][.]example bad.example-",
      "values": []
    }
  ]
}
