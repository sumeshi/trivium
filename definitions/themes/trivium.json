{
  "version": 1,
  "id": "trivium",
  "name": "Trivium",
  "order": 0,
  "mode": "dark",
  "pastel": false,
  "tokens": {
    "bg": "#050716",
    "fg": "#e8eaf2",
    "muted": "#9aa0b0",
    "surface": "#11111b",
    "surface-weak": "#181b29",
    "surface-soft": "#10131f",
    "surface-strong": "#1f2434",
    "overlay": "rgba(3, 5, 15, 0.94)",
    "border": "#262938",
    "border-strong": "#626a87",
    "hover": "color-mix(in srgb, var(--fg) 5%, var(--surface))",
    "heading": "var(--fg)",
    "accent": "#879de9",
    "accent-contrast": "#0d1225",
    "accent-soft": "color-mix(in srgb, var(--accent) 12%, var(--surface))",
    "accent-border": "var(--accent)",
    "positive": "#81d0a5",
    "positive-soft": "color-mix(in srgb, var(--positive) 12%, var(--surface))",
    "warning": "#f0c879",
    "warning-soft": "color-mix(in srgb, var(--warning) 12%, var(--surface))",
    "danger": "#f29b9b",
    "danger-soft": "color-mix(in srgb, var(--danger) 12%, var(--surface))",
    "flag-selected-text": "#111827",
    "flag-safe-text": "var(--positive)",
    "flag-suspicious-text": "var(--warning)",
    "flag-critical-text": "var(--danger)",
    "flag-safe-selected-bg": "color-mix(in srgb, var(--positive) 22%, var(--surface))",
    "flag-safe-selected-fg": "var(--positive)",
    "flag-suspicious-selected-bg": "color-mix(in srgb, var(--warning) 22%, var(--surface))",
    "flag-suspicious-selected-fg": "var(--warning)",
    "flag-critical-selected-bg": "color-mix(in srgb, var(--danger) 22%, var(--surface))",
    "flag-critical-selected-fg": "var(--danger)",
    "bookmark-row-strength": "5%",
    "bookmark": "#efcc7c",
    "bookmark-soft": "color-mix(in srgb, var(--bookmark) 3%, var(--surface))",
    "shadow-soft": "0 8px 24px rgba(0, 0, 0, 0.24)",
    "shadow-strong": "0 18px 48px rgba(0, 0, 0, 0.42)",
    "rule-red": "#4a2b2f",
    "rule-orange": "#4a3323",
    "rule-amber": "#463d20",
    "rule-green": "#24402f",
    "rule-teal": "#1f3b3b",
    "rule-blue": "#26364f",
    "rule-purple": "#362c4a",
    "rule-pink": "#472a3b",
    "flag-safe-selected-border": "color-mix(in srgb, var(--positive) 40%, var(--surface))",
    "flag-suspicious-selected-border": "color-mix(in srgb, var(--warning) 40%, var(--surface))",
    "flag-critical-selected-border": "color-mix(in srgb, var(--danger) 40%, var(--surface))"
  }
