{
  "schemaVersion": 1,
  "id": "powershell-encoded",
  "name": "PowerShell encoded-command payload",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_])(?i:(?:powershell|pwsh)(?:\\.exe)?)(?:[ \\t]+|[\"'][ \\t]+)[^;\\r\\n&|]*?(?i:-(?:e|en|enc|enco|encod|encode|encoded|encodedc|encodedco|encodedcom|encodedcomm|encodedcomma|encodedcomman|encodedcommand))[ \\t]+(?P<value>[A-Za-z0-9+/]{16,}={0,2})(?:\\z|[^A-Za-z0-9+/=])",
  "valueGroup": "value",
  "validation": "powershell-encoded",
  "examples": [
    {
      "text": "powershell.exe -NoProfile -EncodedCommand VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA",
      "values": [
        "VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA"
      ]
    },
    {
      "text": "powershell -enc VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA;pwsh.exe -enc dwBoAG8AYQBtAGkA",
      "values": [
        "VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA",
        "dwBoAG8AYQBtAGkA"
      ]
    },
    {
      "text": "\"C:\\Program Files\\PowerShell\\pwsh.exe\" -EncodedCommand VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA",
      "values": [
        "VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA"
      ]
    },
    {
      "text": "other.exe -enc VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA\npowershell.exe -enc not_base64",
      "values": []
    },
    {
      "text": "powershellnot.exe -enc VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA\npowershell -NoProfile; other.exe -enc VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA",
      "values": []
    },
    {
      "text": "powershell -e VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA;powershell -en VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA;powershell -enco VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA;powershell -encoded VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA;powershell -EncodedCom VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA;powershell -EncodedCommand VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA",
      "values": [
        "VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA",
        "VwByAGkAdABlAC0ASABvAHMAdAAgACcAaABlAGwAbABvACcA",
