{
  "schemaVersion": 1,
  "id": "hash-md5",
  "name": "Hash: MD5-length (32 hex)",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_])(?P<value>[0-9A-Fa-f]{32})(?:\\z|[^\\p{L}\\p{N}_])",
  "valueGroup": "value",
  "examples": [
    {
      "text": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,ABCDEF01ABCDEF01ABCDEF01ABCDEF01",
      "values": [
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "ABCDEF01ABCDEF01ABCDEF01ABCDEF01"
      ]
    },
    {
      "text": "xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa0 gggggggggggggggggggggggggggggggg",
      "values": []
    }
  ]
}
