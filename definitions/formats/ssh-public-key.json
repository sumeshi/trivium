{
  "schemaVersion": 1,
  "id": "ssh-public-key",
  "name": "SSH public key",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_-])(?P<value>(?:ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(?:256|384|521))[ \\t]+[A-Za-z0-9+/]{16,}={0,2})(?:\\z|[^A-Za-z0-9+/=])",
  "valueGroup": "value",
  "validation": "ssh-public-key",
  "examples": [
    {
      "text": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f analyst@example.org",
      "values": [
        "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f"
      ]
    },
    {
      "text": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f\nssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f",
      "values": [
        "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f",
        "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAABAgMEBQYHCAkKCwwNDg8QERITFBUWFxgZGhscHR4f"
      ]
    },
    {
      "text": "ssh-ed25519 AAAACndyb25nLWtpbmQAAAAgAAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=",
      "values": []
    }
  ]
}
