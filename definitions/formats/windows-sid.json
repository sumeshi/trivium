{
  "schemaVersion": 1,
  "id": "windows-sid",
  "name": "Windows SID",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_-])(?P<value>(?i:S)-[0-9]{1,3}-[0-9]{1,15}(?:-[0-9]{1,10}){1,15})(?:\\z|[^\\p{L}\\p{N}_-])",
  "valueGroup": "value",
  "validation": "windows-sid",
  "examples": [
    {
      "text": "user=S-1-5-21-123-456-789-1001,service=S-1-5-18",
      "values": [
        "S-1-5-21-123-456-789-1001",
        "S-1-5-18"
      ]
    },
    {
      "text": "S-1-5-32-544",
      "values": [
        "S-1-5-32-544"
      ]
    },
    {
      "text": "S-2-5-18 S-1-5-4294967296 S-1-281474976710656-18",
      "values": []
    }
  ]
}
