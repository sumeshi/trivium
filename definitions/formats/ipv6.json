{
  "schemaVersion": 1,
  "id": "ipv6",
  "name": "IPv6-like",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_:.%/\\[\\]])(?P<value>(?:\\[[0-9A-Fa-f]{0,4}:[0-9A-Fa-f:.]*(?:%[A-Za-z0-9_.-]{1,64})?\\](?::[0-9]{1,5})?|[0-9A-Fa-f]{0,4}:[0-9A-Fa-f:.]*(?:%[A-Za-z0-9_.-]{1,64})?(?:/[0-9]{1,3})?))(?:\\z|[^\\p{L}\\p{N}_:.%/\\[\\]])",
  "valueGroup": "value",
  "validation": "ipv6-like",
  "examples": [
    {
      "text": "src=[2001:db8::1] loopback=::1 unspecified=::",
      "values": [
        "[2001:db8::1]",
        "::1",
        "::"
      ]
    },
    {
      "text": "::1,2001:db8::2,::ffff:192.0.2.1",
      "values": [
        "::1",
        "2001:db8::2",
        "::ffff:192.0.2.1"
      ]
    },
    {
      "text": "[::1]:80,[2001:DB8::1]:65535,[fe80::1%eth0]:443,[::]",
      "values": [
        "[::1]:80",
        "[2001:DB8::1]:65535",
        "[fe80::1%eth0]:443",
        "[::]"
      ]
    },
    {
      "text": "2001:db8::/32,::/0,::1/128,2001:DB8::1/64",
      "values": [
        "2001:db8::/32",
        "::/0",
        "::1/128",
        "2001:DB8::1/64"
      ]
    },
    {
      "text": "fe80::1%eth0 ::1:443",
      "values": [
        "fe80::1%eth0",
        "::1:443"
      ]
    },
    {
      "text": "bad=2001:db8:::1 12345::1 ::ffff:999.1.2.3",
      "values": []
    },
    {
      "text": "::1/129 ::1/bad ::1/-1 [::1]:65536 [::1]:bad [::1]/128 [::1]:80/128",
      "values": []
    },
    {
      "text": "[::1 [[::1]] ::1] [2001:db8:::1]:80",
      "values": []
    }
  ]
}
