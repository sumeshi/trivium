{
  "schemaVersion": 1,
  "id": "defanged-domain",
  "name": "Defanged domain",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_@.\\]\\)}-])(?P<value>(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.|\\[\\.\\]|\\(\\.\\)|\\{\\.\\}))+(?:[A-Za-z]{2,63}|[Xx][Nn]--[A-Za-z0-9-]{2,59})(?:\\.|\\[\\.\\]|\\(\\.\\)|\\{\\.\\})?)(?:\\z|[^\\p{L}\\p{N}_@.\\[\\(\\{-])",
  "valueGroup": "value",
  "validation": "defanged-domain",
  "examples": [
    {
      "text": "one[.]example,bad.example[.]technology",
      "values": [
        "one[.]example",
        "bad.example[.]technology"
      ]
    },
    {
      "text": "normal.example invalid[.][.]example bad_[.]example",
      "values": []
    },
    {
      "text": "one(.)example,two{.}example,sub[.]example.",
      "values": [
        "one(.)example",
        "two{.}example",
        "sub[.]example."
      ]
    }
  ]
}
