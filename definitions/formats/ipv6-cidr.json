{
  "schemaVersion": 1,
  "id": "ipv6-cidr",
  "name": "IPv6 CIDR",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_:./])(?P<value>[0-9A-Fa-f]{0,4}:[0-9A-Fa-f:.]+/[0-9]{1,3})(?:\\z|[^\\p{L}\\p{N}_:./])",
  "valueGroup": "value",
  "validation": "ipv6-cidr",
  "examples": [
    {
      "text": "net=2001:db8::/32,::/0",
      "values": [
        "2001:db8::/32",
        "::/0"
      ]
    },
    {
      "text": "::1/128 2001:DB8::1/64",
      "values": [
        "::1/128",
        "2001:DB8::1/64"
      ]
    },
    {
      "text": "2001:db8::/129 2001:db8:::1/64",
      "values": []
    }
  ]
}
