{
  "schemaVersion": 1,
  "id": "ipv4-cidr",
  "name": "IPv4 CIDR",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_./])(?P<value>(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,3})(?:\\z|[^\\p{L}\\p{N}_./])",
  "valueGroup": "value",
  "validation": "ipv4-cidr",
  "examples": [
    {
      "text": "net=10.0.0.0/8,192.0.2.1/24",
      "values": [
        "10.0.0.0/8",
        "192.0.2.1/24"
      ]
    },
    {
      "text": "0.0.0.0/0 255.255.255.255/32",
      "values": [
        "0.0.0.0/0",
        "255.255.255.255/32"
      ]
    },
    {
      "text": "256.1.2.3/24 10.0.0.0/33 1.2.3.4/-1",
      "values": []
    }
  ]
}
