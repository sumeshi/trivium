{
  "schemaVersion": 1,
  "id": "url",
  "name": "HTTP / HTTPS URL",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_])(?P<value>(?i:(?:https?|hxxps?))://(?:[^\\s<>\"'()\\[\\]{},;?#]|\\{\\.\\}|\\([^\\s<>\"'()]*\\)|\\[[^\\s<>\"'\\[\\]]*\\])*(?:[^\\s<>\"'()\\[\\]{}.,;:!?,;?#]|\\{\\.\\}|\\([^\\s<>\"'()]*\\)|\\[[^\\s<>\"'\\[\\]]*\\])(?:\\?(?:[^\\s<>\"'()\\[\\]{}#]|\\{\\.\\}|\\([^\\s<>\"'()]*\\)|\\[[^\\s<>\"'\\[\\]]*\\])*(?:[^\\s<>\"'()\\[\\]{}.,;:!?#]|\\{\\.\\}|\\([^\\s<>\"'()]*\\)|\\[[^\\s<>\"'\\[\\]]*\\]))?(?:#(?:[^\\s<>\"'()\\[\\]{}]|\\{\\.\\}|\\([^\\s<>\"'()]*\\)|\\[[^\\s<>\"'\\[\\]]*\\])*(?:[^\\s<>\"'()\\[\\]{}.,;:!?]|\\{\\.\\}|\\([^\\s<>\"'()]*\\)|\\[[^\\s<>\"'\\[\\]]*\\]))?)(?:\\z|[\\s<>\"',;.!?()\\[\\]{}])",
  "valueGroup": "value",
  "validation": "http-url-like",
  "examples": [
    {
      "text": "see https://example.technology/a?x=1&y=2. Next.",
      "values": [
        "https://example.technology/a?x=1&y=2"
      ]
    },
    {
      "text": "(http://[2001:db8::1]:8080/a),https://example.org/wiki/Topic_(test)",
      "values": [
        "http://[2001:db8::1]:8080/a",
        "https://example.org/wiki/Topic_(test)"
      ]
    },
    {
      "text": "https://localhost:8080/ HTTP://example.org/path#section",
      "values": [
        "https://localhost:8080/",
        "HTTP://example.org/path#section"
      ]
    },
    {
      "text": "https://host.example/path?ids=1,2&next=x",
      "values": [
        "https://host.example/path?ids=1,2&next=x"
      ]
    },
    {
      "text": "IOC=hxxps://bad[.]example/path. Next.",
      "values": [
        "hxxps://bad[.]example/path"
      ]
    },
    {
      "text": "http://bad[.]example/a,hxxp://other.example/b,https://one(.)example/a,hxxp://two{.}example/b",
      "values": [
        "http://bad[.]example/a",
        "hxxp://other.example/b",
        "https://one(.)example/a",
        "hxxp://two{.}example/b"
      ]
    },
    {
      "text": "hxxps://host[.]example/path?ids=1,2&next=x",
      "values": [
        "hxxps://host[.]example/path?ids=1,2&next=x"
      ]
    },
    {
      "text": "https:// https://host.invalid:99999/a https://[2001:db8:::1]/ https://bad[.]example:99999/a",
      "values": []
    }
  ]
}
