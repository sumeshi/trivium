{
  "schemaVersion": 1,
  "id": "defanged-ipv4",
  "name": "Defanged IPv4",
  "pattern": "(?:\\A|[^\\p{L}\\p{N}_@.\\]\\)}-])(?P<value>[0-9]{1,3}(?:(?:\\.|\\[\\.\\]|\\(\\.\\)|\\{\\.\\})[0-9]{1,3}){3})(?:\\z|[^\\p{L}\\p{N}_@.\\[\\(\\{-])",
  "valueGroup": "value",
  "validation": "defanged-ipv4",
  "examples": [
    {
      "text": "src=192[.]0[.]2[.]1,10[.]0[.]0[.]1",
      "values": [
        "192[.]0[.]2[.]1",
        "10[.]0[.]0[.]1"
      ]
    },
    {
      "text": "999[.]1[.]2[.]3 192.0.2.1 192[.]0[.]2[.]1[.]5",
      "values": []
    },
    {
      "text": "192(.)0(.)2(.)1,10{.}0{.}0{.}1,192.0[.]2.1",
      "values": [
        "192(.)0(.)2(.)1",
        "10{.}0{.}0{.}1",
        "192.0[.]2.1"
      ]
    },
    {
      "text": "192(.)0(.)2(.)1(.)5 999{.}1{.}2{.}3",
      "values": []
    }
  ]
}
